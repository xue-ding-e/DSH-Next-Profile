{
  "name": "dsh-next-profile",
  "version": "0.2.4",
  "description": "A thin version lock and installer for personal extensions on DeepSeek Harness and DSH Next.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.28.5",
  "bin": { "dsh-next-profile": "src/cli.mjs" },
  "files": ["src", "installer", "profile/manifest.json", "profile/compatibility.json", "profile/feature-matrix.json", "artifacts", "README.md", "README.zh.md", "LICENSE"],
  "engines": { "node": ">=24.9.0" },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build-release.mjs",
    "smoke": "node scripts/smoke-package.mjs",
    "prepack": "node scripts/smoke-package.mjs --directory ."
  }
}
